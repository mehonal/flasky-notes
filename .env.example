# SQLite path — the Docker setup defaults to /app/instance/db.sqlite3
# (inside the persistent volume). Local dev can leave this unset.
DATABASE_URI="sqlite:///db.sqlite3"
SECRET_KEY="super_secret_here"
FLASK_ENV="development"
LOG_LEVEL="WARNING"
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Docker deployment options
# PORT=5000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
